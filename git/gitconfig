[user]
    name = User Name
    email = user.name@gmail.com

[credential]
    helper = store

[core]
    editor = nano
    autocrlf = input
    excludesfile = ~/.gitignore_global
    longpaths = true

[color]
    ui = auto

[alias]
    tuah = push
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --oneline --graph --decorate --all
    amend = commit --amend --no-edit
    pom = push origin main
    psm = push --set-upstream origin main
    last = log -1 HEAD
    save = stash save
    unstage = reset HEAD --
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    filelog = log --follow --name-status --oneline # View file history with status
    bclean = "!git branch --merged | egrep -v '(^\\*|main|develop)' | xargs git branch -d"
    prune-remote = "remote prune origin"
    nb = "!f() { git checkout -b \"$1\" && git push --set-upstream origin \"$1\"; }; f"
    up = "!git remote update -p; git merge --ff-only @{u}"
    sync = "!git pull --rebase --prune; git push"
    stash-pop = stash pop
    stash-list = stash list
    stash-apply = stash apply
    sminit = submodule update --init --recursive
    smupdate = submodule update --recursive --remote
    s = status -sb
    ds = diff --staged
    dsf = diff --staged --name-only
    rml = remote -v
    rmremote = "!sh -c 'git remote remove $0; git remote prune origin'"
    ca = commit -a
    amend-last = commit --amend --reuse-message=HEAD
    editconfig = "!nano ~/.gitconfig"
    whoami = config --get user.name && config --get user.email

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[push]
    default = simple

[fetch]
    prune = true

[rebase]
    autosquash = true

[pull]
    rebase = false

[interactive]
    diffFilter = delta

[delta]
    features = side-by-side line-numbers decorations

[rerere]
    enabled = true
